# KONTROL - variables de entorno (plantilla, sin secretos reales).
# Copie a `.env` y complete los valores. Ningún secreto se versiona (FR-001-005).

# Entorno: local | dev | qa | uat | staging | prod
KONTROL_ENVIRONMENT=prod

# Imágenes Docker (registro y etiqueta; cambie la etiqueta por entorno)
KONTROL_IMAGE_REGISTRY=dvconsultores
KONTROL_IMAGE_TAG=latest    # latest (desarrollo) | main (producción)

# Actualización automática (watchtower): intervalo en segundos entre revisiones
KONTROL_AUTO_UPDATE_INTERVAL=300

# Base de datos EXTERNA (cada cliente la suya). Formato:
# postgresql+psycopg2://usuario:clave@host:puerto/nombre_db
KONTROL_DB_URL=postgresql+psycopg2://kontrol:REEMPLAZAR_POR_CONTRASENA_SEGURA@TU_HOST_DB:5432/kontrol

# Seguridad (obligatoria, >=32 caracteres)
KONTROL_SECRET_KEY=REEMPLAZAR_POR_CLAVE_SEGURA_DE_32_CARACTERES_O_MAS

# Cookies / CORS
KONTROL_COOKIE_SECURE=true
# Lista JSON obligatoria (pydantic-settings exige JSON para listas): ["https://dominio"]
KONTROL_CORS_ORIGINS=["https://tu-dominio.cliente"]

# Puertos: NO se publican puertos de host. El tráfico entra por Nginx Proxy
# Manager (o el proxy del cliente) hacia kontrol-web:80 y kontrol-api:8000
# por una red Docker compartida (kontrol-net).

# Licencia: clave pública Ed25519 del propietario (PEM), el ancla de confianza con la
# que la instalación verifica cada licencia. OBLIGATORIA en prod: el backend no arranca
# sin ella. Nunca se sustituye por la clave de la instalación.
KONTROL_LICENSE_PUBLIC_KEY_PEM=

# Rutas de volúmenes (valores por defecto; se montan como volúmenes)
KONTROL_INSTALLATION_VOLUME_PATH=/data/license-state
KONTROL_STORAGE_PATH=/data/storage
KONTROL_BACKUP_PATH=/data/backups

# Observabilidad
KONTROL_LOG_LEVEL=INFO
KONTROL_LOG_JSON=true

# Zona del anfitrión. Cinturón de seguridad de la fecha de negocio: la autoridad
# vive en el código (`business_timezone`), y el producto es correcto aunque esto
# cambie. Spec 001 · POLICY-CLOCK-LOCAL.
KONTROL_TZ=America/Caracas
