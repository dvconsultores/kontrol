{
  "serverInfo": {
    "name": "deepseek-mcp-server",
    "version": "2.4.0"
  },
  "protocolVersion": "2025-06-18",
  "tools": [
    {
      "name": "deepseek_chat",
      "required": [
        "messages"
      ],
      "optional": [
        "json_mode",
        "max_tokens",
        "model",
        "reasoning_effort",
        "response_schema",
        "session_id",
        "stream",
        "temperature",
        "thinking",
        "tool_choice",
        "tools"
      ],
      "model": {
        "default": "deepseek-flash",
        "description": "Model to use. deepseek-flash (default, V4.1 Flash, fast/economical) or deepseek-v4-pro (V4 Pro), both 1M context, up to 384K output. Non-thinking by default for speed; pass thinking:{type:\"enabled\"} to reason. Legacy names (still accepted, prefer deepseek-flash): deepseek-v4-flash -> deepseek-flash, deepseek-chat -> deepseek-flash non-thinking, deepseek-reasoner -> deepseek-flash thinking.",
        "type": "string",
        "enum": [
          "deepseek-flash",
          "deepseek-v4-pro",
          "deepseek-v4-flash",
          "deepseek-chat",
          "deepseek-reasoner"
        ]
      },
      "output": [
        "content",
        "cost_usd",
        "effective",
        "fallback",
        "finish_reason",
        "json_parse_error",
        "model",
        "reasoning_content",
        "request",
        "routed_from",
        "schema",
        "session_id",
        "tool_calls",
        "usage"
      ]
    },
    {
      "name": "deepseek_fim",
      "required": [
        "prompt"
      ],
      "optional": [
        "max_tokens",
        "model",
        "stop",
        "suffix",
        "temperature"
      ],
      "model": {
        "default": "deepseek-flash",
        "description": "Model to use. deepseek-flash (default, V4.1 Flash, fast/economical) or deepseek-v4-pro (V4 Pro). Legacy names deepseek-v4-flash / deepseek-chat / deepseek-reasoner are still accepted and resolve to deepseek-flash. FIM is always non-thinking.",
        "type": "string",
        "enum": [
          "deepseek-flash",
          "deepseek-v4-pro",
          "deepseek-v4-flash",
          "deepseek-chat",
          "deepseek-reasoner"
        ]
      },
      "output": [
        "cost_usd",
        "finish_reason",
        "model",
        "pricing_tier",
        "routed_from",
        "text",
        "usage"
      ]
    },
    {
      "name": "deepseek_sessions",
      "required": [
        "action"
      ],
      "optional": [
        "session_id"
      ],
      "model": {},
      "output": []
    }
  ]
}
