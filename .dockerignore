# KONTROL - Docker ignore
# Reglas: ninguna imagen Docker debe contener secretos, respaldos, datos de clientes, claves ni licencias privadas.

.git
.gitignore
.dockerignore
.env
.env.*
!.env.example
**/*.pem
**/*.key
**/*.crt
**/*.p12
**/*.pfx
secrets/
backups/
databases/
storage/
volumes/
node_modules/
dist/
build/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage/
htmlcov/
*.log
*.dump
*.sql.gz
license-state/
installation-identity/
evidence/generated/
docs/
specs/
requerimientos/
