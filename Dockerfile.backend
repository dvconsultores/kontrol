# syntax=docker/dockerfile:1

# ==========================================================================
# KONTROL - Backend (multi-stage, no root, versionado)
# Objetivo: Python 3.13. La etapa final `runtime` es la de producción (la que produce un build sin --target); `dev` (hot reload, pruebas y herramientas) solo se obtiene con `--target dev`.
# ==========================================================================
# Base fijada (Spec 052, OD-CERT-06/07): patch tag + distro explícita + digest del ÍNDICE OCI multi-arquitectura (buildx elige linux/amd64). Actualización controlada: re-resolver en el registro, medir, revisar seguridad y recertificar antes de cambiarla; fuente: specs/001-fundacion/certified-deployment-base.json.
FROM python:3.13.16-slim-trixie@sha256:70729b46c69b4f1e97c4822c1af3df53a1476cf5ddc6c087c0c10bc3a5678c2f AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Dependencias del sistema mínimas (psycopg2-binary no requiere compilador).
# libmagic (paquete `libmagic1t64` de trixie, con `libmagic-mgc`) es la detección MIME por contenido de la gestión documental (Spec 046 §19).
# ca-certificates fijado a la versión corregida de DSA-6572-1 (pin temporal y exacto, OD-CERT-08); retirarlo sólo al re-fijar una base oficial que ya lo incluya, verificada y recertificada.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl libmagic1t64 ca-certificates=20250419+deb13u1 \
    && rm -rf /var/lib/apt/lists/*

# Dependencias Python: el conjunto completo y fijado de requirements.lock (OD-CERT-05). --no-deps impide volver a resolver transitivas en el build; pip check hace fallar el build si el conjunto no es completo y coherente.
COPY resources/backend/requirements.lock /tmp/requirements.lock
RUN pip install --no-cache-dir --no-deps -r /tmp/requirements.lock \
    && pip check

COPY resources/backend/app ./app
COPY resources/backend/alembic ./alembic
COPY resources/backend/alembic.ini ./alembic.ini
COPY resources/backend/scripts/entrypoint.sh ./entrypoint.sh

# Usuario no root (seguridad de imagen, DOC-08 §19).
RUN useradd --system --uid 10001 kontrol && mkdir -p /data/license-state /data/storage /data/backups \
    && chown -R kontrol:kontrol /data /app \
    && chmod +x /app/entrypoint.sh
USER kontrol

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health/live')" || exit 1

# Migraciones automáticas al arranque (base externa por cliente) + API.
# `--timeout-keep-alive 75` (BACKEND-KEEPALIVE-5S): uvicorn cierra por defecto una conexión ociosa a los 5 s,
# los mismos que la conserva el agente HTTP de Node (Playwright, el proxy de Vite): una petición enviada en
# ese instante recibe ECONNRESET o se queda sin respuesta. El servidor debe conservarla MÁS que cualquier
# cliente o proxy que la reutilice (Node 5 s; nginx `keepalive_timeout` de upstream 60 s por defecto).
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--timeout-keep-alive", "75"]

# --- Target de desarrollo: hot reload con requirements-test.lock -----------
FROM base AS dev
USER root
COPY resources/backend/tests ./tests
COPY resources/backend/pyproject.toml ./pyproject.toml
# Grafo de certificación fijado (runtime exacto + herramientas), sin volver a resolver;
# nunca en runtime.
COPY resources/backend/requirements-test.lock /tmp/requirements-test.lock
RUN pip install --no-cache-dir --no-deps -r /tmp/requirements-test.lock \
    && pip check
USER kontrol
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--timeout-keep-alive", "75"]

# --- Target de producción (por defecto, última etapa): hereda de `base` todo el runtime —usuario no root, HEALTHCHECK, ENTRYPOINT, CMD sin --reload con keep-alive 75, libmagic— sin `tests/` ni herramientas.
FROM base AS runtime
