# Autoridad Central de Licencias de KONTROL — imagen propia, separada del backend del cliente.
# Solo entra el contrato puro compartido (`app/core/license_contract.py`) y el paquete `central_authority`.
FROM python:3.13-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
COPY resources/backend/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY resources/backend/app/__init__.py ./app/__init__.py
COPY resources/backend/app/core/__init__.py ./app/core/__init__.py
COPY resources/backend/app/core/license_contract.py ./app/core/license_contract.py
COPY resources/backend/central_authority ./central_authority
RUN useradd --system --uid 10002 central && chown -R central:central /app && chmod +x /app/central_authority/entrypoint.sh
USER central
EXPOSE 8010
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8010/health/live')" || exit 1
ENTRYPOINT ["/app/central_authority/entrypoint.sh"]
CMD ["uvicorn", "central_authority.main:app", "--host", "0.0.0.0", "--port", "8010"]
